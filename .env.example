# Copy to .env and adjust as needed.

# Required. Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgres://bipa:bipa@localhost:5432/bipa

# HTTP listen address (default: 0.0.0.0:3000).
BIND_ADDR=0.0.0.0:3000

# Source endpoint (default: mempool.space connectivity ranking).
MEMPOOL_URL=https://mempool.space/api/v1/lightning/nodes/rankings/connectivity

# Seconds between imports, must be > 0 (default: 60).
IMPORT_INTERVAL_SECS=60

# Timeout in seconds for the mempool.space request, must be > 0 (default: 10).
HTTP_CLIENT_TIMEOUT_SECS=10

# Log filter (default: info).
RUST_LOG=info
